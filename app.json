{
  "expo": {
    "name": "Meridian",
    "slug": "new-meridian-app",
    "owner": "kubellingham",
    "version": "0.3.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/39d76476-08c5-469c-8ea0-f9f7a63f56db"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meridian",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080E1A",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.kubellingham.meridian",
      "adaptiveIcon": {
        "backgroundColor": "#080E1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Meridian uses the camera to scan food barcodes and photograph meals for logging."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Meridian uses your photos so your nutrition specialist can log meals from pictures.",
          "cameraPermission": "Meridian uses the camera to photograph meals for logging."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080E1A",
          "dark": {
            "backgroundColor": "#080E1A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39d76476-08c5-469c-8ea0-f9f7a63f56db"
      },
      "feedbackWhatsApp": "255768776677"
    }
  }
}
