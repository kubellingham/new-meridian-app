# Copy to .env and fill in what applies.
#
# ── Distribution (tester/preview builds) ─────────────────────────────
# The app talks to Meridian's own proxy (api/claude.js on the Vercel
# deployment). No vendor keys ever go in a distributed build.
#
# Base URL of the Vercel deployment (e.g. https://meridian-xyz.vercel.app)
EXPO_PUBLIC_MERIDIAN_PROXY_URL=
# Shared app token — must match MERIDIAN_APP_TOKEN in Vercel env.
# Rotating it in Vercel instantly cuts off older builds.
EXPO_PUBLIC_MERIDIAN_APP_TOKEN=
# Sentry DSN for crash reporting (not a secret). Optional.
EXPO_PUBLIC_SENTRY_DSN=
#
# ── Local development ONLY ───────────────────────────────────────────
# Direct Anthropic key fallback for personal dev without the proxy.
# NEVER set this in any build handed to another person.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
#
# ElevenLabs — spoken character replies. Dev-only feature: leave empty
# for tester builds (the app runs text-only and hides voice controls).
EXPO_PUBLIC_ELEVENLABS_API_KEY=
#
# ── Server-side (Vercel project settings, NOT in .env) ───────────────
# ANTHROPIC_API_KEY   — the real key, server-side only.
# MERIDIAN_APP_TOKEN  — same value as EXPO_PUBLIC_MERIDIAN_APP_TOKEN.
